<?xml version="1.0" encoding="utf-8"?>
<!--
  KvsvRequest1.1 #1: "Update mobile application logos which is attached." Replaces the old
  rough placeholder bat+ball glyph with a cleaner mark matching the delivered app-icon set
  (tekadi-icon-primary-green.png/.svg) — same bat/ball silhouette and palette, redrawn as a
  vector so it scales losslessly across every launcher density with no separate PNG exports
  to keep in sync. Geometry is kept inside the adaptive-icon safe zone (the inner ~66dp circle
  of this 108dp canvas) so none of it gets clipped by a circular or squircle mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Ball, upper-right, off-white with a stitched seam -->
    <path android:fillColor="#F7F5F0" android:pathData="M79,29m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />
    <path android:strokeColor="#993C1D" android:strokeWidth="1.6"
        android:pathData="M79,20 Q88,29 79,38" />
    <path android:strokeColor="#993C1D" android:strokeWidth="1"
        android:pathData="M77,22 L81,23 M79,26 L83,27 M80,29 L84,29 M79,32 L83,33 M77,36 L81,35" />

    <!-- Bat: grip, handle, blade with toe stripe, running lower-left to upper-right -->
    <group android:translateX="40" android:translateY="66" android:rotation="-38">
        <path android:fillColor="#173404" android:pathData="M-7,-46 L7,-46 L7,-26 L-7,-26 Z" />
        <path android:fillColor="#6B4423" android:pathData="M-8,-26 L8,-26 L8,6 L-8,6 Z" />
        <path android:fillColor="#F7F5F0" android:pathData="M-13,6 L13,6 L13,42 L-13,42 Z" />
        <path android:fillColor="#F2994A" android:pathData="M-13,32 L13,32 L13,42 L-13,42 Z" />
    </group>
</vector>
